import donna/files
import donna/list
import donna/string
import parsetoml/parsetoml
import leaf/site

pub type Page:
  Page(title: String, slug: String, date: String, layout: String, draft: Bool, tags: String, weight: Int, source: String, body: String, read_minutes: Int)

type Front:
  Front(meta: parsetoml.TomlValue, body: String)

pub fn collect(config: site.Config) -> List(Page):
  collect_dir(site.content_dir(config), site.content_dir(config), [], False)

pub fn collect_all(config: site.Config) -> List(Page):
  collect_dir(site.content_dir(config), site.content_dir(config), [], True)

fn collect_dir(
  root: String,
  dir: String,
  acc: List(Page),
  include_drafts: Bool
) -> List(Page):
  collect_entries(root, dir, files.list_dir(dir), acc, include_drafts)

fn collect_entries(
  root: String,
  dir: String,
  entries: List(String),
  acc: List(Page),
  include_drafts: Bool
) -> List(Page):
  case entries:
    [] -> acc
    [name, ..rest] ->
      let path = files.join(dir, name)
      case files.is_dir(path):
        True ->
          collect_entries(
            root,
            dir,
            rest,
            collect_dir(root, path, acc, include_drafts),
            include_drafts
          )
        False ->
          case string.ends_with(name, ".md"):
            False -> collect_entries(root, dir, rest, acc, include_drafts)
            True ->
              let page = parse(root, path)
              case include_drafts:
                True ->
                  collect_entries(
                    root,
                    dir,
                    rest,
                    [page, ..acc],
                    include_drafts
                  )
                False ->
                  case draft(page):
                    True ->
                      collect_entries(root, dir, rest, acc, include_drafts)
                    False ->
                      collect_entries(
                        root,
                        dir,
                        rest,
                        [page, ..acc],
                        include_drafts
                      )

fn parse(root: String, path: String) -> Page:
  let front = split_front_matter(files.read(path))
  let meta = meta_of(front)
  let fallback = fallback_slug(root, path)
  let body = body_of(front)
  Page(
    toml_string(meta, "title", title_from_slug(fallback)),
    toml_string(meta, "slug", fallback),
    toml_string(meta, "date", ""),
    toml_string(meta, "layout", default_layout(fallback)),
    toml_bool(meta, "draft", False),
    tags_string(meta),
    toml_int(meta, "weight", 100),
    path,
    body,
    read_minutes(body)
  )

fn split_front_matter(src: String) -> Front:
  let lines = string.split(src, "\n")
  case lines:
    ["---", ..rest] -> read_front(rest, [])
    _ -> Front(parsetoml.TomlTable([]), src)

fn read_front(lines: List(String), meta_acc: List(String)) -> Front:
  case lines:
    [] -> Front(parsetoml.TomlTable([]), "")
    [line, ..rest] ->
      case string.equal(line, "---"):
        True ->
          let meta_src = string.join(list.reverse(meta_acc), "\n")
          let body = string.join(rest, "\n")
          case parsetoml.parse(meta_src):
            parsetoml.Ok(t) -> Front(t, body)
            parsetoml.Err(_) -> Front(parsetoml.TomlTable([]), body)
        False -> read_front(rest, [line, ..meta_acc])

fn fallback_slug(root: String, path: String) -> String:
  let no_ext = files.drop_extension(path)
  let prefix = root <> "/"
  case string.starts_with(no_ext, prefix):
    True ->
      let rel = string.slice(
        no_ext,
        string.length(prefix),
        string.length(no_ext) - string.length(prefix)
      )
      normalize_index(rel)
    False -> normalize_index(files.drop_extension(files.basename(path)))

fn normalize_index(slug: String) -> String:
  case string.ends_with(slug, "/_index"):
    True -> string.slice(slug, 0, string.length(slug) - 7)
    False ->
      case string.equal(slug, "_index"):
        True -> "index"
        False -> slug

fn default_layout(slug: String) -> String:
  case string.equal(slug, "index"):
    True -> "home"
    False ->
      case string.ends_with(slug, "tags"):
        True -> "taxonomy"
        False -> "page"

fn title_from_slug(slug: String) -> String:
  string.replace(files.basename(slug), "-", " ")

fn tags_string(meta: parsetoml.TomlValue) -> String:
  case parsetoml.get_array(meta, "tags"):
    parsetoml.Ok(xs) -> tags_from_values(xs, "")
    parsetoml.Err(_) -> toml_string(meta, "tags", "")

fn tags_from_values(xs: List(parsetoml.TomlValue), acc: String) -> String:
  case xs:
    [] -> acc
    [x, ..rest] ->
      case x:
        parsetoml.TomlString(s) ->
          case string.is_empty(acc):
            True -> tags_from_values(rest, s)
            False -> tags_from_values(rest, acc <> "," <> s)
        _ -> tags_from_values(rest, acc)

fn read_minutes(body: String) -> Int:
  let words = count_words(string.split(body, " "), 0)
  let mins = words / 200
  case mins <= 0:
    True -> 1
    False -> mins

fn count_words(words: List(String), acc: Int) -> Int:
  case words:
    [] -> acc
    [w, ..rest] ->
      case string.is_empty(string.trim(w)):
        True -> count_words(rest, acc)
        False -> count_words(rest, acc + 1)

fn meta_of(f: Front) -> parsetoml.TomlValue:
  case f:
    Front(m, _) -> m

fn body_of(f: Front) -> String:
  case f:
    Front(_, b) -> b

fn toml_string(
  t: parsetoml.TomlValue,
  key: String,
  default_value: String
) -> String:
  case parsetoml.get_string(t, key):
    parsetoml.Ok(s) -> s
    parsetoml.Err(_) -> default_value

fn toml_bool(t: parsetoml.TomlValue, key: String, default_value: Bool) -> Bool:
  case parsetoml.get_bool(t, key):
    parsetoml.Ok(b) -> b
    parsetoml.Err(_) -> default_value

fn toml_int(t: parsetoml.TomlValue, key: String, default_value: Int) -> Int:
  case parsetoml.get_int(t, key):
    parsetoml.Ok(n) -> n
    parsetoml.Err(_) -> default_value

pub fn title(p: Page) -> String:
  case p:
    Page(x, _, _, _, _, _, _, _, _, _) -> x

pub fn slug(p: Page) -> String:
  case p:
    Page(_, x, _, _, _, _, _, _, _, _) -> x

pub fn date(p: Page) -> String:
  case p:
    Page(_, _, x, _, _, _, _, _, _, _) -> x

pub fn layout(p: Page) -> String:
  case p:
    Page(_, _, _, x, _, _, _, _, _, _) -> x

pub fn draft(p: Page) -> Bool:
  case p:
    Page(_, _, _, _, x, _, _, _, _, _) -> x

pub fn tags(p: Page) -> String:
  case p:
    Page(_, _, _, _, _, x, _, _, _, _) -> x

pub fn weight(p: Page) -> Int:
  case p:
    Page(_, _, _, _, _, _, x, _, _, _) -> x

pub fn source(p: Page) -> String:
  case p:
    Page(_, _, _, _, _, _, _, x, _, _) -> x

pub fn body(p: Page) -> String:
  case p:
    Page(_, _, _, _, _, _, _, _, x, _) -> x

pub fn read_time(p: Page) -> Int:
  case p:
    Page(_, _, _, _, _, _, _, _, _, x) -> x

pub fn kind(p: Page) -> String:
  let s = slug(p)
  case string.starts_with(s, "posts/"):
    True -> "post"
    False ->
      case string.equal(s, "docs") || string.starts_with(s, "docs/"):
        True -> "doc"
        False ->
          case string.equal(s, "books") || string.starts_with(s, "books/"):
            True -> "book"
            False ->
              case string.equal(s, "index"):
                True -> "home"
                False -> "page"

pub fn url_path(p: Page) -> String:
  pretty_path(slug(p))

pub fn pretty_path(slug: String) -> String:
  case string.equal(slug, "index"):
    True -> ""
    False -> slug <> "/"
