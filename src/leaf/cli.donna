import argparse
import donna/io
import donna/string
import leaf/commands
import leaf/ui

pub fn run() -> Nil:
  let args = argparse.from_argv()
  let pos = argparse.positional(args)
  let cmd = first(pos, "build")
  case wants_help(args, cmd):
    True -> io.println(ui.help())
    False ->
      case wants_version(args, cmd):
        True -> io.println(ui.version)
        False -> dispatch(args, pos, cmd)

fn dispatch(
  args: List(#(String, String)),
  pos: List(String),
  cmd: String
) -> Nil:
  case cmd:
    "init" -> io.println(commands.init(second(pos, "site")))
    "theme" -> io.println(commands.theme(second(pos, "default")))
    "new" ->
      io.println(commands.new(second(pos, "post"), third(pos, "untitled")))
    "build" -> io.println(commands.build())
    "serve" ->
      io.println(commands.serve(port(args), argparse.has(args, "watch")))
    "serve-only" -> io.println(commands.serve_only(port(args)))
    "clean" -> io.println(commands.clean())
    "doctor" -> io.println(commands.doctor())
    "list" -> io.println(commands.list_content())
    "help" -> io.println(ui.help())
    _ -> io.println(ui.help())

fn wants_help(args: List(#(String, String)), cmd: String) -> Bool:
  argparse.has(args, "h") || argparse.has(args, "help") || string.equal(cmd, "-h") || string.equal(cmd, "--help")

fn wants_version(args: List(#(String, String)), cmd: String) -> Bool:
  argparse.has(args, "v") || argparse.has(args, "version") || string.equal(cmd, "-v") || string.equal(cmd, "--version")

fn port(args: List(#(String, String))) -> Int:
  let raw = argparse.get(args, "port")
  case string.is_empty(raw):
    True -> 1313
    False -> string.to_int(raw)

fn first(xs: List(String), default: String) -> String:
  case xs:
    [] -> default
    [x, .._] -> x

fn second(xs: List(String), default: String) -> String:
  case xs:
    [_, x, .._] -> x
    _ -> default

fn third(xs: List(String), default: String) -> String:
  case xs:
    [_, _, x, .._] -> x
    _ -> default
