import parsetoml/parsetoml
import donna/files
import donna/string

pub type Config:
  Config(title: String, base_url: String, content_dir: String, output_dir: String, asset_dir: String, static_dir: String, theme: String, posts_per_page: Int, author: String, social: String, comments: String, contact: String)

pub fn read() -> Config:
  case parsetoml.parse(files.read("config.toml")):
    parsetoml.Err(_) -> default()
    parsetoml.Ok(toml) ->
      Config(
        toml_string(toml, "title", "Leaf"),
        toml_string(toml, "base_url", ""),
        toml_string(toml, "content_dir", "content"),
        toml_string(toml, "output_dir", "public"),
        toml_string(toml, "asset_dir", "assets"),
        toml_string(toml, "static_dir", "static"),
        toml_string(toml, "theme", "default"),
        toml_int(toml, "paginate", toml_int(toml, "posts_per_page", 5)),
        toml_string(toml, "author", "Leaf"),
        toml_string(toml, "social", ""),
        toml_string(toml, "comments", "none"),
        toml_string(toml, "contact", "mailto:hello@example.com")
      )

pub fn default() -> Config:
  Config(
    "Leaf",
    "",
    "content",
    "public",
    "assets",
    "static",
    "default",
    5,
    "Leaf",
    "",
    "none",
    "mailto:hello@example.com"
  )

pub fn title(c: Config) -> String:
  case c:
    Config(x, _, _, _, _, _, _, _, _, _, _, _) -> x

pub fn base_url(c: Config) -> String:
  case c:
    Config(_, x, _, _, _, _, _, _, _, _, _, _) -> x

pub fn content_dir(c: Config) -> String:
  case c:
    Config(_, _, x, _, _, _, _, _, _, _, _, _) -> x

pub fn output_dir(c: Config) -> String:
  case c:
    Config(_, _, _, x, _, _, _, _, _, _, _, _) -> x

pub fn asset_dir(c: Config) -> String:
  case c:
    Config(_, _, _, _, x, _, _, _, _, _, _, _) -> x

pub fn static_dir(c: Config) -> String:
  case c:
    Config(_, _, _, _, _, x, _, _, _, _, _, _) -> x

pub fn theme(c: Config) -> String:
  case c:
    Config(_, _, _, _, _, _, x, _, _, _, _, _) -> x

pub fn posts_per_page(c: Config) -> Int:
  case c:
    Config(_, _, _, _, _, _, _, x, _, _, _, _) -> x

pub fn author(c: Config) -> String:
  case c:
    Config(_, _, _, _, _, _, _, _, x, _, _, _) -> x

pub fn social(c: Config) -> String:
  case c:
    Config(_, _, _, _, _, _, _, _, _, x, _, _) -> x

pub fn comments(c: Config) -> String:
  case c:
    Config(_, _, _, _, _, _, _, _, _, _, x, _) -> x

pub fn contact(c: Config) -> String:
  case c:
    Config(_, _, _, _, _, _, _, _, _, _, _, x) -> x

pub fn extra_string(key: String, default_value: String) -> String:
  case parsetoml.parse(files.read("config.toml")):
    parsetoml.Ok(toml) -> toml_string(toml, key, default_value)
    parsetoml.Err(_) -> default_value

pub fn extra_int(key: String, default_value: Int) -> Int:
  case parsetoml.parse(files.read("config.toml")):
    parsetoml.Ok(toml) -> toml_int(toml, key, default_value)
    parsetoml.Err(_) -> default_value

pub fn extra_bool(key: String, default_value: Bool) -> Bool:
  case parsetoml.parse(files.read("config.toml")):
    parsetoml.Ok(toml) -> toml_bool(toml, key, default_value)
    parsetoml.Err(_) -> default_value

pub fn theme_dir(c: Config) -> String:
  files.join("themes", theme(c))

pub fn layouts_dir(c: Config) -> String:
  files.join(theme_dir(c), "layouts")

pub fn theme_assets_dir(c: Config) -> String:
  files.join(theme_dir(c), "assets")

pub fn theme_static_dir(c: Config) -> String:
  files.join(theme_dir(c), "static")

pub fn asset_base(c: Config) -> String:
  extra_string("asset_base", "/assets")

pub fn url(c: Config, path: String) -> String:
  case string.is_empty(base_url(c)):
    True -> "/" <> path
    False -> base_url(c) <> "/" <> path

fn toml_string(
  t: parsetoml.TomlValue,
  key: String,
  default_value: String
) -> String:
  case parsetoml.get_string(t, key):
    parsetoml.Ok(s) -> s
    parsetoml.Err(_) -> default_value

fn toml_int(t: parsetoml.TomlValue, key: String, default_value: Int) -> Int:
  case parsetoml.get_int(t, key):
    parsetoml.Ok(n) -> n
    parsetoml.Err(_) -> default_value

fn toml_bool(t: parsetoml.TomlValue, key: String, default_value: Bool) -> Bool:
  case parsetoml.get_bool(t, key):
    parsetoml.Ok(b) -> b
    parsetoml.Err(_) -> default_value
